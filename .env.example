# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (อย่า commit .env.local)

# ---------- Supabase ----------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# publishable (anon) key — เปิดเผยในเบราว์เซอร์ได้ จึงต้องเปิด RLS ด้วย supabase/rls.sql
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# โดเมนของเว็บ ใช้สร้างลิงก์ล็อกอิน เช่น http://localhost:3000 หรือ https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- ฐานข้อมูล ----------
# Supabase > Connect > connection string (ฝั่งเซิร์ฟเวอร์และ drizzle-kit push)
DATABASE_URL=

# ---------- AI (OpenRouter) ----------
OPENROUTER_API_KEY=
# ไม่ใส่ = anthropic/claude-haiku-4.5
OPENROUTER_MODEL=
# โมเดลสำรอง คั่นด้วยจุลภาค
OPENROUTER_FALLBACK_MODELS=
# โมเดลที่อ่านรูปได้ (โหงวเฮ้ง) ไม่ใส่ = anthropic/claude-haiku-4.5
OPENROUTER_VISION_MODEL=
# ไม่ใส่ = google/gemini-2.5-flash
OPENROUTER_VISION_FALLBACK_MODELS=

# ---------- แอดมิน ----------
# แนะนำ: UUID ผู้ใช้ Supabase ของแอดมิน คั่นด้วยจุลภาค (ถ้าตั้งไว้ จะใช้รายการนี้อย่างเดียว)
ADMIN_USER_IDS=
# ทางเลือก: อีเมลแอดมิน (ต้องเป็นอีเมลที่ยืนยันแล้ว และควรเปิด Confirm email ใน Supabase)
ADMIN_EMAILS=

# ---------- รับเงิน ----------
# เบอร์พร้อมเพย์ (เช่น 0812345678) หรือเลขบัตร/ผู้เสียภาษี 13 หลัก ที่รับเงินเข้า
PROMPTPAY_ID=

# ---------- Slip2Go (ตรวจสลิปอัตโนมัติ + สร้าง QR) ----------
# ไม่ตั้ง = ใช้แบบแอดมินกดยืนยันมือ
# base URL และ Secret Key ดูในแดชบอร์ด app.slip2go.com
SLIP2GO_API_URL=
SLIP2GO_SECRET=
# จำเป็นต่อการเปิดตรวจสลิปอัตโนมัติ: บัญชีผู้รับเงินที่สลิปต้องโอนเข้า
# ประเภทเช่น 02001 (พร้อมเพย์เบอร์โทร) 02003 (พร้อมเพย์เลขบัตร/ผู้เสียภาษี) 01004 (กสิกร) ดูรหัสอื่นในเอกสาร Slip2Go
SLIP2GO_RECEIVER_TYPE=
SLIP2GO_RECEIVER_ACCOUNT=
# ไม่บังคับ: ให้ Slip2Go สร้าง QR จาก PROMPTPAY_ID (ไม่ตั้ง = สร้างเองในเครื่อง)
# phone_number | citizen_id | e_wallet
SLIP2GO_PROMPTPAY_TYPE=
# ชื่อบัญชีผู้รับ ตามที่ขึ้นในแอปธนาคาร
SLIP2GO_ACCOUNT_NAME=

# ---------- ตารางเวลาสร้างดวง ----------
# สุ่มสตริงยาวๆ เช่น openssl rand -hex 32 — Vercel Cron จะแนบ Authorization: Bearer <ค่านี้> ให้เอง
CRON_SECRET=
