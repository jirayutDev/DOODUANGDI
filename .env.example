# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (อย่า commit .env.local)

# ---------- Supabase ----------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# publishable (anon) key — เปิดเผยในเบราว์เซอร์ได้ จึงต้องเปิด RLS ด้วย supabase/rls.sql
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# โดเมนของเว็บ ใช้สร้างลิงก์ล็อกอิน เช่น http://localhost:3000 หรือ https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- ฐานข้อมูล ----------
# Supabase > Connect > connection string (ฝั่งเซิร์ฟเวอร์และ drizzle-kit push)
DATABASE_URL=

# ---------- AI (OpenRouter) ----------
OPENROUTER_API_KEY=
# ไม่ใส่ = anthropic/claude-haiku-4.5
OPENROUTER_MODEL=
# โมเดลสำรอง คั่นด้วยจุลภาค
OPENROUTER_FALLBACK_MODELS=
# โมเดลที่อ่านรูปได้ (โหงวเฮ้ง) ไม่ใส่ = anthropic/claude-haiku-4.5
OPENROUTER_VISION_MODEL=
# ไม่ใส่ = google/gemini-2.5-flash
OPENROUTER_VISION_FALLBACK_MODELS=

# ---------- แอดมิน ----------
# ล็อกอินแอดมินแยกจากผู้ใช้ทั่วไป: รัน `npm run admin:setup` เพื่อสร้าง 3 ค่านี้ (ไม่แสดงรหัสผ่านจริง)
# path ลับของหน้าแอดมิน เช่น m1a2b3c4d5e6-9f8e7d (a-z 0-9 - ยาว 8-48 ตัว) เข้าที่ https://โดเมน/<ค่านี้> ไม่ตั้ง = ปิดหน้าแอดมินทั้งหมด
ADMIN_PATH=
# ชื่อผู้ใช้แอดมิน (ตั้งเอง)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ---------- รับเงิน ----------
# Payso (Pay Solutions) PromptPay QR — ค่าอยู่ใน Payso Control Panel > Merchant Settings > Merchant Details
# เลข Merchant ID 8 หลัก
PAYSO_MERCHANT_ID=
# Auth Key (Parameter Key panel) ใช้สร้าง QR
PAYSO_AUTH_KEY=
# apikey / secretkey สำหรับ Inquiry API (ขอจากเจ้าหน้าที่ Payso) ใช้เช็กสถานะซ้ำก่อนเติม coin
PAYSO_API_KEY=
PAYSO_SECRET_KEY=
# ไม่บังคับ: เปลี่ยน base URL (ค่าเริ่มต้น https://apis.paysolutions.asia ซึ่งเป็น production เท่านั้น)
PAYSO_BASE_URL=
# ตั้ง Postback URL ใน Payso Control Panel เป็น https://โดเมนของคุณ/api/payments/payso/postback

# ---------- ตารางเวลาสร้างดวง ----------
# สุ่มสตริงยาวๆ เช่น openssl rand -hex 32 — Vercel Cron จะแนบ Authorization: Bearer <ค่านี้> ให้เอง
CRON_SECRET=

# ---------- ส่ง SMS OTP ด้วย SMSKUB (สำหรับเข้าสู่ระบบด้วยเบอร์โทร ผ่าน Supabase Send SMS Hook) ----------
# ดูค่าทั้งหมดในหน้า console.sms-kub.com และเอกสาร API (documenter.getpostman.com/view/9887776/2sAYXCjyAF)
SMSKUB_BASE_URL=
SMSKUB_API_KEY=
# ชื่อผู้ส่ง ตัวอังกฤษ/ตัวเลข ไม่เกิน 11 ตัว (ต้องได้รับอนุมัติใน console)
SMSKUB_SENDER=
# secret ของ Supabase Auth Hook (Authentication > Hooks > Send SMS) รูปแบบ v1,whsec_...
SEND_SMS_HOOK_SECRET=

# ---------- จองคิวหมอดู (วิดีโอผ่าน Google Meet) ----------
# สร้างห้อง Google Meet อัตโนมัติผ่าน Google Calendar API ด้วยบัญชี Google ของเว็บ (ไม่ตั้ง = หมอดูวางลิงก์ Meet เอง)
# สร้าง OAuth client (Web) ใน Google Cloud Console เปิด Google Calendar API แล้วขอ refresh token ด้วยสิทธิ์ calendar.events
# ผ่าน https://developers.google.com/oauthplayground (ติ๊ก Use your own OAuth credentials) — คีย์ทั้งสามเป็นความลับ
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ค่าบริการเว็บ (%) และอัตราแลก coin เป็นบาทสำหรับโอนให้หมอดู ตั้งในหลังบ้าน เมนู "ตั้งราคา" (ไม่ใช้ env แล้ว)

# ---------- ผู้ให้บริการ AI (เปลี่ยนเจ้าได้โดยไม่แก้โค้ด) ----------
# ไม่ตั้ง = ใช้ OpenRouter ด้วย OPENROUTER_API_KEY / OPENROUTER_MODEL ตามด้านบน
# ตั้งเพื่อใช้เจ้าอื่นที่เรียกแบบ OpenAI (POST <AI_BASE_URL>/chat/completions) เช่น MaxPlus AI:
#   AI_BASE_URL=https://api.maxplus-ai.cc/v1   AI_API_KEY=ccsk-...   AI_MODEL=claude-haiku-4-5-20251001
AI_BASE_URL=
AI_API_KEY=
# โมเดลหลัก/สำรอง (สำรองคั่นจุลภาค) ใช้ชื่อโมเดลของเจ้านั้นๆ
AI_MODEL=
AI_FALLBACK_MODELS=
# สายอ่านรูปใบหน้า (โหงวเฮ้ง): ไม่ตั้ง = ใช้เจ้าเดียวกับสายหลัก (รูปใบหน้าจะไปเจ้านั้นด้วย) ตั้งสองบรรทัดนี้ถ้าอยากแยกไปเจ้าอื่น
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
# โมเดลอ่านรูป/สำรอง (ต้องเป็นโมเดลที่รองรับรูปในเจ้านั้น) เช่น MaxPlus: claude-haiku-4-5-20251001
AI_VISION_MODEL=
AI_VISION_FALLBACK_MODELS=
# สายสำรอง (pool/เจ้าที่ 2): ถ้าสายหลักล่ม (5xx, คีย์/เครดิตมีปัญหา, ต่อไม่ติด) หรือล้มทุกโมเดล ระบบจะสลับมาสายนี้เอง (ทั้งแชท ดวง จับคู่ และอ่านรูป)
# ต้องตั้ง BASE_URL และ API_KEY ทั้งคู่ถึงเปิดใช้ ชื่อโมเดลใช้ของเจ้านั้น เช่น Gemini บน MaxPlus: AI_BACKUP_BASE_URL=https://api.maxplus-ai.cc/gemini-premium/v1  AI_BACKUP_MODEL=gemini-2.5-flash
AI_BACKUP_BASE_URL=
AI_BACKUP_API_KEY=
AI_BACKUP_MODEL=
AI_BACKUP_FALLBACK_MODELS=
# โมเดลอ่านรูปของสายสำรอง ไม่ตั้ง = ใช้ AI_BACKUP_MODEL
AI_BACKUP_VISION_MODEL=
